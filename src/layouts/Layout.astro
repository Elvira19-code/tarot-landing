---
import '@fontsource/cormorant-garamond/400.css';
import '@fontsource/cormorant-garamond/400-italic.css';
import '@fontsource/cormorant-garamond/cyrillic-400.css';
import '@fontsource/cormorant-garamond/cyrillic-400-italic.css';
import '@fontsource/manrope/400.css';
import '@fontsource/manrope/500.css';
import '@fontsource/manrope/cyrillic-400.css';
import '../styles/global.css';
import { brand } from '../data/site';
import AgeGate from '../components/AgeGate.astro';
import ServiceChoice from '../components/ServiceChoice.astro';
import ContactDetails from '../components/ContactDetails.astro';
import { seo } from '../data/seo';
const path = Astro.url.pathname === '/404.html' ? '/404/' : Astro.url.pathname.replace(/\/?$/, '/');
const { title, description } = seo[path] ?? Astro.props;
const privatePage = ['/order/', '/order-result/', '/admin/'].includes(path);
const canonical = Astro.site && path !== '/404/' ? new URL(path, Astro.site).href : undefined;
const links = [['/','Главная'],['/services/','Услуги'],['/about/','Обо мне'],['/process/','Как всё проходит'],['/reviews/','Отзывы']];
---
<!doctype html>
<html lang="ru"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="description" content={description}/><meta name="theme-color" content="#0b1026"/><title>{title}</title>{canonical && <link rel="canonical" href={canonical}/>}<meta name="robots" content={privatePage || path === '/404/' || !Astro.site ? 'noindex, follow' : 'index, follow'}/><link rel="icon" href="/favicon.svg"/></head>
<body>
<AgeGate/>
<a class="skip" href="#main">К содержанию</a>
<header class="header wrap"><a class="brand" href="/" aria-label="Точка ясности — главная"><img src="/favicon.svg" alt="" width="36" height="36"/><span>ТОЧКА ЯСНОСТИ<small>ТАРО И АСТРОЛОГИЯ · ЭЛЬВИРА КЕЛЬИНА</small></span></a><button class="menu-toggle" aria-label="Открыть меню" aria-expanded="false" aria-controls="navigation"><i data-lucide="menu"></i></button><nav id="navigation" aria-label="Основная навигация">{links.map(([href,text])=><a href={href} aria-current={Astro.url.pathname===href?'page':undefined}>{text}</a>)}<a class="nav-contact" href="/contact/" aria-current={Astro.url.pathname==='/contact/'?'page':undefined}>Записаться <i data-lucide="arrow-up-right"></i></a></nav></header>
<main id="main"><slot/></main>
<footer class="footer wrap" id="footer">
<div class="footer-top"><a class="brand" href="/">ТОЧКА ЯСНОСТИ</a><p>Будущее открыто.<br/>Ваш выбор имеет значение.</p><ContactDetails/><a href="/contact/">Начать разговор <i data-lucide="arrow-up-right"></i></a></div>
<div class="footer-bottom"><span>© {new Date().getFullYear()} Эльвира Кельина</span><div class="footer-legal"><a href="/18plus/">18+</a><a href="/privacy/">Конфиденциальность</a><a href="/consent/">Согласие на обработку данных</a><a href="/offer/">Публичная оферта</a><a href="/advertising-consent/">Согласие на рекламу</a><button type="button" id="chat-settings" class="chat-settings">Настройки чата</button></div><span>Бережно. Честно. По существу.</span></div><p class="disclaimer">Символические практики для саморефлексии. Не заменяют медицинскую, психологическую, юридическую или финансовую помощь.</p></footer>
<script>
import { createIcons, ArrowUpRight, ArrowRight, ArrowDown, Menu, X, Plus, Check, Send, MessageCircle, Copy } from 'lucide';
createIcons({icons:{ArrowUpRight,ArrowRight,ArrowDown,Menu,X,Plus,Check,Send,MessageCircle,Copy}});
const menu = document.querySelector<HTMLButtonElement>('.menu-toggle');
menu?.addEventListener('click',()=>{ const open = menu.getAttribute('aria-expanded') !== 'true'; menu.setAttribute('aria-expanded',String(open)); menu.setAttribute('aria-label',open?'Закрыть меню':'Открыть меню'); document.querySelector('#navigation')?.classList.toggle('is-open',open); });
document.addEventListener('keydown',e=>{if(e.key==='Escape'){menu?.setAttribute('aria-expanded','false');document.querySelector('#navigation')?.classList.remove('is-open');}});
</script>
<script is:inline>
(function () {
  if (/^\/(?:order(?:-result)?|admin)\/?$/.test(window.location.pathname)) return;
  if (!window.chatbase || window.chatbase('getState') !== 'initialized') {
    window.chatbase = (...args) => {
      if (!window.chatbase.q) window.chatbase.q = [];
      window.chatbase.q.push(args);
    };
    window.chatbase = new Proxy(window.chatbase, {
      get(target, prop) {
        if (prop === 'q') return target.q;
        return (...args) => target(prop, ...args);
      }
    });
  }
  const onLoad = function () {
    if (document.getElementById('HS9ZK_ZPpkiVtG_e6skIE')) return;
    const script = document.createElement('script');
    script.src = 'https://www.chatbase.co/embed.min.js';
    script.id = 'HS9ZK_ZPpkiVtG_e6skIE';
    script.domain = 'www.chatbase.co';
    document.body.appendChild(script);
  };
  window.addEventListener('taroway-enable-chat', onLoad);
  try { if (localStorage.getItem('taroway-chat-choice-v1') === 'allow') onLoad(); } catch {}
})();
</script>
{!privatePage && <ServiceChoice/>}
</body></html>
