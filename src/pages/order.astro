---
import Layout from '../layouts/Layout.astro';
import BookingCalendar from '../components/BookingCalendar.astro';
import TarotPicker from '../components/TarotPicker.astro';
import {catalog,spreads} from '../../server/catalog.mjs';
---
<Layout title="Заказать разбор | Точка ясности" description="Выбор персонального гороскопа, натальной карты или расклада Таро.">
<section class="wrap order-page"><p class="eyebrow">ИНДИВИДУАЛЬНЫЙ РАЗБОР</p><h1>Ваш вопрос.<br/><em>Внимание к деталям.</em></h1><p>Выберите услугу и оставьте заявку. Стоимость, доступность и способ получения результата согласуем до оплаты.</p>
<p id="orders-paused" role="status" hidden>Временно запись не принимается. Пожалуйста, зайдите позже.</p><form id="order-form"><fieldset><legend>1. Выберите услугу</legend><div class="order-options">{Object.entries(catalog).map(([id,item])=><label><input type="radio" name="service" value={id} required checked={id==='day'}/><span>{item.name}<strong>{item.price} ₽</strong></span></label>)}</div></fieldset>
<fieldset><legend>2. Данные для разбора</legend><div class="fields"><label class="field">Имя<input name="name" required maxlength="80" autocomplete="given-name"/></label></div><fieldset class="receipt-options"><legend>Куда отправить чек</legend><label><input type="radio" name="receiptMethod" value="email" checked/> На email</label><label><input type="radio" name="receiptMethod" value="sms"/> По СМС</label><label class="field" id="receipt-email">Email<input name="email" type="email" required maxlength="150" autocomplete="email"/></label><label class="field" id="receipt-phone" hidden>Телефон<input name="phone" type="tel" maxlength="25" autocomplete="tel" placeholder="Номер с кодом страны" disabled/></label></fieldset>
<div id="astro-fields" class="fields"><label class="field">Дата рождения<input name="birth" type="date" required min="1900-01-01"/></label><label class="field">Время рождения, если известно<input name="time" type="time"/></label><label class="field full">Место рождения<input name="place" required maxlength="160" placeholder="Страна, город"/></label><label class="field" id="period-field">Начало периода<input name="start" type="date" required/></label></div><p id="period-note" class="note">Неделя: 7 дней. Месяц: 30 дней от выбранной даты, включая первый день.</p>
<div id="consultation-fields" hidden><BookingCalendar/><label class="field">Тема консультации<textarea name="consultationQuestion" maxlength="1000"/></label><p class="note">Личная онлайн-консультация. Выбранное время сохраняется в заявке. Встреча состоится после подтверждения записи. Все часы указаны по Москве. Фото и дополнительные данные сейчас не требуются.</p></div><div id="tarot-fields" hidden><label class="field">Ваш вопрос<textarea name="question" maxlength="1000"/></label><label class="field">Расклад<select name="spread"><option value="choice">Выбор пути · 5 карт</option><option value="relationship">Вокзал на двоих · 7 карт</option><option value="cross">Кельтский крест · 10 карт</option></select></label><TarotPicker/></div>
</fieldset><label class="consent"><input name="ageConfirmed" type="checkbox" required/> <span>Я подтверждаю, что мне исполнилось 18 лет</span></label><label class="consent"><input name="offer" type="checkbox" required/> <span>Принимаю <a href="/offer/" target="_blank" rel="noopener noreferrer">условия оферты</a>.</span></label><label class="consent"><input name="consent" type="checkbox" required/> <span>Даю отдельное <a href="/consent/" target="_blank" rel="noopener noreferrer">согласие на обработку данных</a>.</span></label><button class="button" type="submit" disabled>Проверить заказ <i data-lucide="arrow-right"/></button></form>
<section id="review-order" hidden><h2>3. Проверьте заказ</h2><pre id="order-summary"></pre><p>Проверьте сведения перед отправкой. Оплата на этом этапе не требуется.</p><div class="payment-preview"><p>Сумма заказа: <strong id="payment-amount"></strong></p><button type="button" class="button" id="confirm-order">Отправить заявку <i data-lucide="arrow-right"/></button></div><button type="button" class="button secondary" id="edit-order">Изменить</button></section><p id="order-error" role="alert"></p></section>
<script>
import {catalog,spreads} from '../../server/catalog.mjs';
const form=document.querySelector<HTMLFormElement>('#order-form')!;let cards:number[]=[];let reversed:boolean[]=[];let payload:any;const error=document.querySelector('#order-error')!;const review=document.querySelector<HTMLElement>('#review-order')!;
const age=form.querySelector<HTMLInputElement>('[name=ageConfirmed]')!;
const submit=form.querySelector<HTMLButtonElement>('button[type=submit]')!;
let accepting=false,calendarReady=false;
const syncAge=()=>{submit.disabled=!age.checked||!accepting||(String(new FormData(form).get('service')).startsWith('consultation_')&&!calendarReady);};
form.addEventListener('booking-availability',((event:CustomEvent)=>{accepting=event.detail.accepting===true;calendarReady=event.detail.ready;document.querySelector<HTMLElement>('#orders-paused')!.hidden=event.detail.accepting!==false;form.hidden=event.detail.accepting===false;syncAge();}) as EventListener);
function syncReceipt(){const sms=new FormData(form).get('receiptMethod')==='sms';for(const [id,active] of [['receipt-email',!sms],['receipt-phone',sms]] as const){const el=document.getElementById(id)!;el.hidden=!active;const input=el.querySelector('input')!;input.disabled=!active;input.required=active;}}
form.addEventListener('change',syncReceipt);syncReceipt();
age.checked=false;syncAge();
age.addEventListener('change',syncAge);
window.addEventListener('pageshow',()=>{age.checked=false;syncAge();review.hidden=true;});
const today=new Date().toLocaleDateString('en-CA');(form.elements.namedItem('start') as HTMLInputElement).value=today;(form.elements.namedItem('start') as HTMLInputElement).min=today;(form.elements.namedItem('birth') as HTMLInputElement).max=today;
const chosen=new URLSearchParams(location.search).get('service');if(chosen&&Object.hasOwn(catalog,chosen))(form.querySelector(`input[value="${chosen}"]`) as HTMLInputElement).checked=true;
function sync(){const data=new FormData(form);const consultation=String(data.get('service')).startsWith('consultation_');const tarot=data.get('service')==='tarot',period=!consultation&&!tarot&&data.get('service')!=='natal';for(const [id,active]of [['astro-fields',!tarot&&!consultation],['tarot-fields',tarot],['consultation-fields',consultation]] as const){const el=document.getElementById(id)!;el.hidden=!active;el.querySelectorAll<HTMLInputElement>('input,select,textarea').forEach(input=>input.disabled=!active);}const start=form.elements.namedItem('start') as HTMLInputElement;start.disabled=!period;document.getElementById('period-field')!.hidden=!period;document.getElementById('period-note')!.hidden=!period;(form.elements.namedItem('question') as HTMLTextAreaElement).required=tarot;(form.elements.namedItem('consultationQuestion') as HTMLTextAreaElement).required=consultation;review.hidden=true;syncAge();}
form.addEventListener('change',sync);form.addEventListener('input',()=>review.hidden=true);
form.addEventListener('tarot-selection',((event:CustomEvent)=>{cards=event.detail.cards;reversed=event.detail.reversed;review.hidden=true;}) as EventListener);
form.addEventListener('submit',e=>{e.preventDefault();if(!form.reportValidity())return;error.textContent='';const data=Object.fromEntries(new FormData(form));payload={...data,ageConfirmed:data.ageConfirmed==='on',consent:data.consent==='on',offer:data.offer==='on',cards:[...cards],reversed:[...reversed]};const item=catalog[data.service as keyof typeof catalog];if(data.service==='tarot'&&cards.length!==spreads[data.spread as keyof typeof spreads]){error.textContent='Выберите нужное число карт.';return;}let period='';if(item.days){const end=new Date(String(data.start));end.setUTCDate(end.getUTCDate()+item.days-1);period=`\nПериод: ${data.start} — ${end.toISOString().slice(0,10)}`;}document.getElementById('order-summary')!.textContent=`${item.name}\nСтоимость: ${item.price} ₽\nИмя: ${data.name}\nЧек: ${data.receiptMethod==='sms'?'по СМС, '+data.phone:'на email, '+data.email}${period}`+(String(data.service).startsWith('consultation_')?`\nТема: ${data.consultationQuestion}\nЗапись: ${data.appointmentDate}, ${data.appointmentTime} МСК.`:data.service==='tarot'?`\nВопрос: ${data.question}\nКарты (позиции): ${cards.map(n=>n+1).join(', ')}`:`\nРождение: ${data.birth}, ${data.time||'время неизвестно'}\nМесто: ${data.place}`);document.getElementById('payment-amount')!.textContent=new Intl.NumberFormat('ru-RU',{style:'currency',currency:'RUB',maximumFractionDigits:0}).format(item.price);review.hidden=false;review.scrollIntoView({behavior:'smooth'});});
document.getElementById('edit-order')!.addEventListener('click',()=>{review.hidden=true;form.scrollIntoView();});
document.getElementById('confirm-order')!.addEventListener('click',async(e)=>{const button=e.currentTarget as HTMLButtonElement;button.disabled=true;try{const response=await fetch('/api/orders',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(payload)});if(!(response.headers.get('content-type')||'').includes('application/json'))throw Error('Откройте актуальную серверную версию сайта.');const result=await response.json();if(!response.ok)throw Error(result.error);sessionStorage.setItem('order-token',result.token);location.href='/order-result/';}catch(e){error.textContent=(e as Error).message;}finally{button.disabled=false;}});sync();
</script><style>.payment-preview{display:flex;align-items:center;justify-content:space-between;gap:20px;flex-wrap:wrap;margin:24px 0;padding:24px 0;border-block:1px solid var(--line)}.payment-preview p{margin:0}.payment-preview strong{color:var(--gold);white-space:nowrap;font-size:24px}.payment-preview .button{max-width:100%}.receipt-options{margin:20px 0;padding:20px 0;border:0;border-block:1px solid var(--line)}.receipt-options>label:not(.field){display:inline-flex;align-items:center;gap:10px;margin:12px 28px 20px 0;min-height:44px}.receipt-options input[type=radio]{width:20px;height:20px;min-height:20px;padding:0;accent-color:var(--gold)}.receipt-options .field{max-width:500px}</style></Layout>
