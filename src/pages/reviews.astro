---
import Layout from '../layouts/Layout.astro';
import PageHead from '../components/PageHead.astro';
const examples = [
 ['О выборе','«Вместо ответа “увольняться или нет” я увидела, какие условия работы для меня важны. Теперь есть список вопросов, которые хочу обсудить с руководителем».','Иллюстрация запроса о работе','Таро-разбор'],
 ['Об отношениях','«Самым полезным оказался разговор о том, чего я сама хочу от отношений. Стало проще подготовиться к честному разговору, который я давно откладывала».','Иллюстрация запроса об отношениях','Таро-разбор'],
 ['О себе','«Я пришла с ощущением, что стою на месте. Ушла с несколькими небольшими шагами, которые могу попробовать, не переворачивая всю жизнь за один день».','Иллюстрация запроса о переменах','Полный разбор'],
 ['О поддержке','«Было важно, что со мной не спорили и ничего не навязывали. Я могла задавать вопросы и сама решать, какие мысли мне подходят».','Иллюстрация впечатления от встречи','Онлайн-консультация']
];
---
<Layout title="Отзывы о консультациях — демонстрационные примеры"><PageHead crumb="Отзывы" eyebrow="ПОСЛЕ НАШЕГО РАЗГОВОРА" title="У каждой истории" accent="свой отклик." description="Здесь появятся отзывы клиентов, опубликованные с их разрешения. Пока ниже — вымышленные примеры, показывающие возможные темы обратной связи."/><section class="content-section wrap"><div class="reviews">{examples.map(([title,quote,author,type])=><article class="review"><span class="example">ПРИМЕР · НЕ РЕАЛЬНЫЙ ОТЗЫВ</span><h2 style="font-size:32px;margin:22px 0 0">{title}</h2><blockquote>{quote}</blockquote><p>{author}</p><footer>{type}</footer></article>)}</div></section><section class="closing wrap"><h2>Ваша история<br/><em>может начаться с разговора.</em></h2><a class="button" href="/contact/">Обсудить мой вопрос <i data-lucide="arrow-up-right"/></a></section></Layout>
