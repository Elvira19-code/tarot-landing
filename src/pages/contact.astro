---
import Layout from '../layouts/Layout.astro';
import BookingCalendar from '../components/BookingCalendar.astro';
import ContactDetails from '../components/ContactDetails.astro';
import PageHead from '../components/PageHead.astro';
import { brand, services, faqs } from '../data/site';
---
<Layout title="Записаться к тарологу Эльвире Кельиной — контакты и вопросы"><PageHead crumb="Запись и контакты" eyebrow="НАЧНЁМ С ВАШЕГО ВОПРОСА" title="Время" accent="для себя." description="Расскажите немного о своём запросе. Формат, время встречи и детали обсудим лично."/>
<section class="content-section wrap"><div class="contact-grid"><p id="booking-paused" role="status" hidden>Временно запись не принимается. Пожалуйста, зайдите позже.</p><form id="booking-form" class="contact-form"><h2>Запись на консультацию</h2><p class="note" style="margin-top:0">Выберите свободное время и оставьте контакт. Заявка сохранится на сервере; Эльвира свяжется с вами для подтверждения встречи.</p><noscript><p>Для записи через календарь включите JavaScript.</p></noscript><div class="fields"><label class="field" for="name">Ваше имя<input id="name" name="name" autocomplete="given-name" required maxlength="80" placeholder="Как к вам обращаться"/></label><label class="field" for="contact">Контакт для ответа<input id="contact" name="contact" autocomplete="off" required minlength="3" maxlength="120" placeholder="@telegram или телефон"/></label><label class="field full" for="service">Формат консультации<select id="service" name="service" required><option value="">Выберите формат</option>{services.map(s=><option value={s.id}>{s.name} · {s.price}</option>)}<option value="unsure">Помогите определиться</option></select></label><label class="field full" for="question">Ваш вопрос <span class="note" style="margin:0">Необязательно. Достаточно нескольких слов.</span><textarea id="question" name="question" maxlength="2000" placeholder="О чём вам хотелось бы поговорить?"/></label></div><BookingCalendar/><label class="consent" for="booking-age"><input type="checkbox" id="booking-age" name="ageConfirmed" required autocomplete="off"/><span>Я подтверждаю, что мне исполнилось 18 лет</span></label><label class="consent" for="offer"><input type="checkbox" id="offer" name="offer" required/><span>Я принимаю условия <a href="/offer/" target="_blank" rel="noopener noreferrer">Публичной оферты</a>.</span></label><label class="consent" for="consent"><input type="checkbox" id="consent" name="consent" required/><span>Я даю <a href="/consent/" target="_blank" rel="noopener noreferrer">согласие на обработку персональных данных</a> и ознакомлен(а) с <a href="/privacy/" target="_blank" rel="noopener noreferrer">Политикой</a>.</span></label><button type="submit" class="button" disabled>Отправить заявку <i data-lucide="arrow-up-right"/></button><div class="form-result" id="form-result" hidden role="status" tabindex="-1"><h3>Заявка сохранена</h3><p id="booking-text"></p><p>Эльвира свяжется с вами по указанному контакту. Для отмены или переноса сообщите номер заявки.</p></div><p id="booking-error" role="alert"></p></form><aside class="contact-aside"><p class="eyebrow">ЛИЧНОЕ ОБЩЕНИЕ</p><h2>Другой способ<br/><em>начать разговор.</em></h2><p>Эльвира Кельина<br/>Индивидуальные консультации онлайн</p><ContactDetails/><a class="button" href={brand.telegram} target="_blank" rel="noopener noreferrer">Записаться на консультацию <i data-lucide="arrow-up-right"/></a><p class="note">Консультации проводятся по предварительной записи на оговоренное время или после подтверждения, что время свободно. Личные консультации: понедельник — пятница, 11:00, 13:00, 15:00 или 17:00 по московскому времени. Не более трёх консультаций в день.</p><p class="note">Пожалуйста, не отправляйте через форму фотографии, документы и сведения о здоровье. Всё необходимое для выбранного разбора обсудим лично.</p></aside></div></section><section class="services-band"><div class="wrap faq"><p class="eyebrow">ПЕРЕД ВСТРЕЧЕЙ</p><h2>Возможно, вы<br/><em>хотели спросить.</em></h2>{faqs.map(([q,a])=><details><summary>{q}<i data-lucide="plus"/></summary><p>{a}</p></details>)}</div></section>
<script>
const form=document.querySelector<HTMLFormElement>('#booking-form')!,service=document.querySelector<HTMLSelectElement>('#service')!,age=form.querySelector<HTMLInputElement>('[name=ageConfirmed]')!,button=form.querySelector<HTMLButtonElement>('[type=submit]')!,result=document.querySelector<HTMLElement>('#form-result')!,error=document.querySelector<HTMLElement>('#booking-error')!;
const selected=new URLSearchParams(location.search).get('service');if(selected&&[...service.options].some(o=>o.value===selected))service.value=selected;
let accepting=false,ready=false,sending=false,complete=false;
const sync=()=>{button.disabled=!age.checked||!accepting||!ready||sending||complete;};
age.checked=false;age.addEventListener('change',sync);
form.addEventListener('booking-availability',((event:CustomEvent)=>{accepting=event.detail.accepting===true;ready=event.detail.ready;document.querySelector<HTMLElement>('#booking-paused')!.hidden=event.detail.accepting!==false;form.hidden=event.detail.accepting===false;sync();}) as EventListener);
form.addEventListener('submit',async event=>{event.preventDefault();if(!form.reportValidity()||button.disabled)return;sending=true;sync();error.textContent='';try{const data=Object.fromEntries(new FormData(form));const response=await fetch('/api/bookings',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({...data,ageConfirmed:age.checked,offer:data.offer==='on',consent:data.consent==='on'})});const value=await response.json();if(!response.ok)throw Error(value.error);document.querySelector('#booking-text')!.textContent='Заявка №'+value.id+'. '+value.date+', '+value.time+' МСК.';result.hidden=false;result.focus();complete=true;}catch(e){error.textContent=(e as Error).message;form.querySelector('[data-booking-calendar]')!.dispatchEvent(new Event('refresh-slots'));}finally{sending=false;sync();}});
window.addEventListener('pageshow',()=>{age.checked=false;sync();});
</script>
</Layout>
