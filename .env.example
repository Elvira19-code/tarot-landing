# Public site origin. Required for production SEO; never use the local preview URL.
SITE_URL=https://taroway.com
# Server only. Never expose these as PUBLIC_* Astro variables.
BOT_TOKEN=
ROBOKASSA_LOGIN=
ROBOKASSA_PASSWORD_1=
ROBOKASSA_PASSWORD_2=
CLOUD_RU_API_KEY_FILE=/etc/taroway/cloudru.key
CLOUD_RU_BASE_URL=https://foundation-models.api.cloud.ru/v1
CLOUD_RU_MODEL=ai-sage/GigaChat3.5-432B-A28B
PAYMENT_MODE=requests
APP_ORIGIN=https://taroway.com
PORT=4322
# Optional: private data directory and a random admin key (32+ characters).
# If ADMIN_TOKEN is omitted, the server creates DATA_DIR/admin.token.
DATA_DIR=
ADMIN_TOKEN=
